{"componentChunkName":"component---src-templates-blog-post-js","path":"/database-isolation-level/","result":{"data":{"site":{"siteMetadata":{"title":"홈","siteUrl":"https://inyoung.dev","author":{"name":"Inyoung Chung"}}},"allMarkdownRemark":{"nodes":[{"fields":{"slug":"/database-isolation-level/"},"frontmatter":{"title":"[데이터베이스] 트랜잭션 격리 수준 4단계 쉽게 이해하기","date":"2026-04-27","tags":["DB"],"pointColor":"#ffffff"}},{"fields":{"slug":"/database-lock-based-concurrency-control/"},"frontmatter":{"title":"[데이터베이스] 락(Lock) 기반 동시성 제어","date":"2026-04-27","tags":["DB"],"pointColor":"#ffffff"}},{"fields":{"slug":"/database-concurrency-control/"},"frontmatter":{"title":"[데이터베이스] 동시성 제어와 스케줄의 개념","date":"2026-04-26","tags":["DB"],"pointColor":"#ffffff"}},{"fields":{"slug":"/software-engineering-solid-principles/"},"frontmatter":{"title":"[소프트웨어공학] SOLID 원칙 이해하기","date":"2026-02-25","tags":["소프트웨어공학"],"pointColor":"#ffffff"}},{"fields":{"slug":"/spring-ioc-di-concepts/"},"frontmatter":{"title":"Spring Framework의 핵심 개념 이해하기 - IoC와 DI","date":"2026-02-24","tags":["Web"],"pointColor":"#6EB442"}},{"fields":{"slug":"/software-engineering-oop-4-principles/"},"frontmatter":{"title":"[소프트웨어공학] 객체 지향(OOP) 4대 특징 이해하기","date":"2026-02-24","tags":["소프트웨어공학"],"pointColor":"#ffffff"}},{"fields":{"slug":"/boj-1106-hotel/"},"frontmatter":{"title":"[백준 JAVA] 호텔 1106 머릿속에 박아넣기","date":"2026-02-20","tags":["알고리즘"],"pointColor":"#ffffff"}},{"fields":{"slug":"/http-advanced-features/"},"frontmatter":{"title":"[네트워크] HTTP의 응용 - 쿠키, 캐시, 보안","date":"2026-02-17","tags":["네트워크"],"pointColor":"#ffffff"}},{"fields":{"slug":"/http-fundamentals/"},"frontmatter":{"title":"[네트워크] HTTP의 기초 - DNS와 HTTP Message, Method, Status (스압 주의) ","date":"2026-02-16","tags":["네트워크"],"pointColor":"#ffffff"}},{"fields":{"slug":"/transport-layer-tcp-udp/"},"frontmatter":{"title":"[네트워크] 전송 계층 - TCP와 UDP","date":"2026-02-15","tags":["네트워크"],"pointColor":"#ffffff"}},{"fields":{"slug":"/network-layer-ip-protocol/"},"frontmatter":{"t